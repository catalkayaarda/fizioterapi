generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum TherapistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  DIPLOMA
  LICENSE
}

enum PackageMode {
  PHYSICAL
  ONLINE
  BOTH
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MessageSenderRole {
  PATIENT
  THERAPIST
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(PATIENT)
  therapistProfile TherapistProfile?
  conversations    Conversation[]    @relation("PatientConversations")
  sentMessages     Message[]         @relation("SentMessages")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([role])
}

model TherapistProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  title           String?
  bio             String?
  city            String?
  status          TherapistStatus     @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  documents       TherapistDocument[]
  specialties     TherapistSpecialty[]
  packages        TherapistPackage[]
  conversations   Conversation[]
  reviews         TherapistReview[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

model TreatmentType {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String               @unique
  description     String?
  specialties     TherapistSpecialty[]
  packages        TherapistPackage[]
  assessmentRules AssessmentRule[]
  assessmentResults AssessmentResult[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model TherapistDocument {
  id                 String           @id @default(cuid())
  therapistProfileId String
  therapistProfile   TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  type               DocumentType
  fileUrl            String
  originalName       String
  mimeType           String
  createdAt          DateTime         @default(now())

  @@index([therapistProfileId])
}

model TherapistSpecialty {
  id                 String           @id @default(cuid())
  therapistProfileId String
  therapistProfile   TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  treatmentTypeId    String
  treatmentType      TreatmentType    @relation(fields: [treatmentTypeId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([therapistProfileId, treatmentTypeId])
  @@index([treatmentTypeId])
}

model TherapistPackage {
  id                 String           @id @default(cuid())
  therapistProfileId String
  therapistProfile   TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  treatmentTypeId    String
  treatmentType      TreatmentType    @relation(fields: [treatmentTypeId], references: [id], onDelete: Restrict)
  name               String
  sessionCount       Int
  price              Decimal          @db.Decimal(10, 2)
  mode               PackageMode
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([therapistProfileId])
  @@index([treatmentTypeId])
}

model TherapistReview {
  id                 String           @id @default(cuid())
  therapistProfileId String
  therapistProfile   TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  rating             Int
  comment            String?
  authorName         String?
  createdAt          DateTime         @default(now())

  @@index([therapistProfileId])
}

model AssessmentResult {
  id                         String        @id @default(cuid())
  recommendedTreatmentTypeId String?
  recommendedTreatmentType   TreatmentType? @relation(fields: [recommendedTreatmentTypeId], references: [id], onDelete: SetNull)
  answers                    Json
  scores                     Json
  createdAt                  DateTime      @default(now())

  @@index([recommendedTreatmentTypeId])
}

model AssessmentQuestion {
  id        String             @id @default(cuid())
  key       String             @unique
  text      String
  order     Int
  options   AssessmentOption[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([order])
}

model AssessmentOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  label      String
  rules      AssessmentRule[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([questionId, value])
}

model AssessmentRule {
  id              String           @id @default(cuid())
  optionId        String
  option          AssessmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  treatmentTypeId String
  treatmentType   TreatmentType    @relation(fields: [treatmentTypeId], references: [id], onDelete: Cascade)
  weight          Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([optionId, treatmentTypeId])
}

model Conversation {
  id                 String             @id @default(cuid())
  patientId          String
  patient            User               @relation("PatientConversations", fields: [patientId], references: [id], onDelete: Cascade)
  therapistProfileId String
  therapistProfile   TherapistProfile   @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  status             ConversationStatus @default(PENDING)
  lastMessageAt      DateTime?
  messages           Message[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([patientId, therapistProfileId])
  @@index([patientId])
  @@index([therapistProfileId])
  @@index([status])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     MessageSenderRole
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}
