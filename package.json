{
  "name": "fizioterapi",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @fizioterapi/db prisma:generate",
    "db:migrate": "pnpm --filter @fizioterapi/db prisma:migrate",
    "db:seed": "pnpm --filter @fizioterapi/db prisma:seed",
    "railway:build": "DATABASE_URL=postgresql://build:build@localhost:5432/build turbo run build --filter=@fizioterapi/api..."
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
